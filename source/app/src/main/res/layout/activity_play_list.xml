<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="a"
            type="com.movie_hub.android.ui.main.account.playlist.PlayListActivity" />

        <variable
            name="vm"
            type="com.movie_hub.android.ui.main.account.playlist.PlayListViewModel" />

        <import type="android.view.View" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_app"
        android:fitsSystemWindows="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"
                android:background="@color/header_app">

                <FrameLayout
                    android:id="@+id/back"
                    android:layout_width="@dimen/_36sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:onClick="@{(v)->a.finish()}">
                    <ImageView
                        android:layout_width="@dimen/_12sdp"
                        android:layout_height="@dimen/_12sdp"
                        android:src="@drawable/ic_arrow_right"
                        android:rotation="180"
                        android:layout_gravity="center"/>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_my_play_list"
                    style="@style/Text_14_Bold"
                    android:layout_toEndOf="@+id/back"
                    android:layout_centerVertical="true"
                    />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/_12sdp"
                    android:gravity="center"
                    android:id="@+id/btn_add_new"
                    android:clickable="true"
                    android:focusable="true"
                    android:onClick="onClick"
                    android:background="@drawable/bg_btn_press_tran"
                    android:padding="@dimen/_6sdp">

                    <ImageView
                        android:layout_width="@dimen/_12sdp"
                        android:layout_height="@dimen/_12sdp"
                        android:src="@drawable/ic_add_new"
                        android:layout_marginEnd="@dimen/_6sdp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text_12_Normal"
                        android:text="@string/add_new"
                        />

                </LinearLayout>


            </RelativeLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">
                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/rv_playlist"
                        android:paddingVertical="@dimen/_6sdp"/>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_6sdp"
                        android:layout_marginHorizontal="@dimen/_12sdp">

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_alignParentStart="true">

                            <TextView
                                android:id="@+id/tv_name_playlist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/Text_14_Normal"
                                android:text="Name"
                                android:maxLength="20"
                                android:layout_gravity="center_vertical"/>

                            <com.facebook.shimmer.ShimmerFrameLayout
                                android:id="@+id/shimmer_name_play_list"
                                android:layout_width="@dimen/_90sdp"
                                android:layout_height="@dimen/_16sdp"
                                android:background="@drawable/bg_shimmer_radius_6sdp"
                                android:layout_gravity="center_vertical"
                                android:visibility="gone"/>

                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true">
                            <TextView
                                android:id="@+id/btn_manage_playlist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/Text_14_Normal"
                                android:text="@string/manage"
                                android:textColor="@color/text_manage_playlist"
                                android:clickable="true"
                                android:focusable="true"
                                android:onClick="onClick"
                                android:background="@drawable/bg_btn_press_tran"
                                android:paddingVertical="@dimen/_3sdp"
                                android:paddingHorizontal="@dimen/_6sdp"/>

                            <com.facebook.shimmer.ShimmerFrameLayout
                                android:id="@+id/shimmer_manage_playlist"
                                android:layout_width="@dimen/_60sdp"
                                android:layout_height="@dimen/_16sdp"
                                android:background="@drawable/bg_shimmer_radius_6sdp"
                                android:layout_gravity="center_vertical"
                                android:visibility="gone" />
                        </FrameLayout>



                    </RelativeLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <androidx.recyclerview.widget.RecyclerView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:id="@+id/rv_movie"/>

                        <FrameLayout
                            android:id="@+id/layout_empty_movie"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/bg_app"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_gravity="center|top"
                                android:layout_marginTop="@dimen/_84sdp"
                                android:visibility="visible">
                                <ImageView
                                    android:layout_width="@dimen/_60sdp"
                                    android:layout_height="@dimen/_60sdp"
                                    android:src="@drawable/ic_empty"
                                    android:layout_gravity="center"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/Text_12_Normal"
                                    android:text="@string/movie_list_empty"
                                    android:textColor="@color/text_empty"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="@dimen/_6sdp"/>
                            </LinearLayout>

                        </FrameLayout>

                    </FrameLayout>
                </LinearLayout>



                <FrameLayout
                    android:id="@+id/layout_empty_main"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/bg_app"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_gravity="center|top"
                        android:layout_marginTop="@dimen/_84sdp"
                        android:visibility="visible">
                        <ImageView
                            android:layout_width="@dimen/_60sdp"
                            android:layout_height="@dimen/_60sdp"
                            android:src="@drawable/ic_empty"
                            android:layout_gravity="center"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text_12_Normal"
                            android:text="@string/movie_list_empty"
                            android:textColor="@color/text_empty"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/_6sdp"/>
                    </LinearLayout>

                </FrameLayout>


            </FrameLayout>


        </LinearLayout>
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/bottom_loading_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:indeterminate="true"
            android:visibility="gone"
            app:trackThickness="1dp"
            app:indicatorColor="@color/ic_tab_bar_tint"
            app:trackColor="@android:color/transparent"
            style="@style/Widget.MaterialComponents.LinearProgressIndicator"
            android:layout_marginBottom="@dimen/_25sdp"/>

        <FrameLayout
            android:id="@+id/loading_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"/>
    </FrameLayout>

</layout>