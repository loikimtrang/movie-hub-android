<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="a"
            type="com.movie_hub.android.ui.main.account.forgot_password.ChangePasswordActivity" />

        <variable
            name="vm"
            type="com.movie_hub.android.ui.main.account.forgot_password.ForgotPasswordViewModel" />

        <import type="android.view.View" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_app"
        android:fitsSystemWindows="true">


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:id="@+id/scrollView">

            <LinearLayout
                android:id="@+id/layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/bg_app"
                android:clickable="true">


                <ImageView
                    android:layout_width="@dimen/_60sdp"
                    android:layout_height="@dimen/_60sdp"
                    android:src="@drawable/logo"
                    android:layout_marginTop="@dimen/_36sdp"
                    android:layout_gravity="center_horizontal"
                    />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reset_password"
                    style="@style/Text_14_Bold"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:textSize="@dimen/_24ssp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mgs_otp"
                    style="@style/Text_12_Normal"
                    android:textColor="@color/text_gray"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/_12sdp"/>
                <TextView
                    android:id="@+id/email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text_12_Normal"
                    android:textColor="@color/btn_login"
                    android:layout_marginStart="@dimen/_3sdp"
                    android:paddingVertical="@dimen/_6sdp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="@dimen/_20sdp"/>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/CustomOutlinedBox"
                        app:endIconMode="custom"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:layout_marginTop="@dimen/_6sdp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/new_password"
                            android:inputType="textPassword"
                            android:singleLine="true"
                            style="@style/Text_12_Normal"
                            android:paddingHorizontal="@dimen/_12sdp"/>
                    </com.google.android.material.textfield.TextInputLayout>


                    <FrameLayout
                        android:id="@+id/hide_password"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="@dimen/_20sdp">
                        <ImageView
                            android:id="@+id/iv_toggle_password"
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:src="@drawable/ic_eye_hidden"
                            android:layout_marginHorizontal="@dimen/_6sdp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginTop="@dimen/_5sdp"/>
                    </FrameLayout>


                </FrameLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/CustomOutlinedBox"
                        app:endIconMode="custom"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:layout_marginTop="@dimen/_6sdp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/re_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/confirm_new_password"
                            style="@style/Text_12_Normal"
                            android:clickable="true"
                            android:paddingHorizontal="@dimen/_12sdp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:inputType="textPassword"
                            />
                    </com.google.android.material.textfield.TextInputLayout>

                    <FrameLayout
                        android:id="@+id/hide_re_password"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="@dimen/_20sdp">
                        <ImageView
                            android:id="@+id/iv_toggle_re_password"
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:src="@drawable/ic_eye_hidden"
                            android:layout_marginHorizontal="@dimen/_6sdp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginTop="@dimen/_5sdp"/>
                    </FrameLayout>
                </FrameLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_otp"
                        android:layout_width="@dimen/_160sdp"
                        android:layout_height="wrap_content"
                        style="@style/CustomOutlinedBox"
                        app:endIconMode="custom"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:layout_alignParentStart="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/otp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/authentication_code"
                            style="@style/Text_12_Normal"
                            android:clickable="true"
                            android:paddingHorizontal="@dimen/_12sdp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:inputType="number"
                            android:maxLength="6"
                            />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/btn_resend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text_12_Normal"
                        android:textColor="@color/btn_login"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:padding="@dimen/_6sdp"
                        android:text="@string/resend_otp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/_16sdp"
                        android:onClick="onClick"
                        android:background="@drawable/bg_btn_press_tran"
                        android:layout_toEndOf="@id/layout_otp"/>
                </RelativeLayout>



                <FrameLayout
                    android:id="@+id/btn_change_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:layout_marginBottom="@dimen/_20sdp"
                    android:onClick="onClick"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_change_password"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_btn_yellow_radius_3sdp"
                        style="@style/Text_12_Bold"
                        android:text="@string/reset_password"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:paddingVertical="@dimen/_12sdp"/>

                    <ProgressBar
                        android:id="@+id/change_password_loading"
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_gravity="center"
                        android:visibility="invisible"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/black" />
                </FrameLayout>

            </LinearLayout>

        </ScrollView>

        <FrameLayout
            android:id="@+id/back"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_40sdp"
            android:onClick="@{(v)->a.finish()}"
            android:layout_gravity="top|start"
            >
            <ImageView
                android:layout_width="@dimen/_12sdp"
                android:layout_height="@dimen/_12sdp"
                android:src="@drawable/ic_arrow_right"
                android:rotation="180"
                android:layout_gravity="center"/>
        </FrameLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/bottom_loading_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:indeterminate="true"
            android:visibility="gone"
            app:trackThickness="1dp"
            app:indicatorColor="@color/ic_tab_bar_tint"
            app:trackColor="@android:color/transparent"
            style="@style/Widget.MaterialComponents.LinearProgressIndicator"
            android:layout_marginBottom="@dimen/_25sdp"/>

        <FrameLayout
            android:id="@+id/loading_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"/>
    </FrameLayout>
</layout>