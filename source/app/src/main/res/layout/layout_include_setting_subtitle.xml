<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_subtitle_options"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/_8sdp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:background="@drawable/bg_subtitle_preview_panel_setting">

        <TextView
            android:id="@+id/tv_preview_subtitle"
            style="@style/Text_14_Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/subtitle_preview_sample" />
    </FrameLayout>

    <TextView
        style="@style/Text_12_Normal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_6sdp"
        android:text="@string/subtitle_font_size" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_12sdp"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_12sdp">

        <RelativeLayout
            android:id="@+id/btn_size_small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_4sdp"
            android:layout_weight="1"
            android:background="@drawable/bg_subtitle_size_item"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/_6sdp">

            <TextView
                style="@style/Text_12_Normal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/subtitle_font_size_small"
                android:textColor="@color/text" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/btn_size_medium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_4sdp"
            android:layout_weight="1"
            android:background="@drawable/bg_subtitle_size_item"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/_6sdp">

            <TextView
                style="@style/Text_12_Normal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/subtitle_font_size_medium"
                android:textColor="@color/text" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/btn_size_large"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_weight="1"
            android:background="@drawable/bg_subtitle_size_item"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/_6sdp">

            <TextView
                style="@style/Text_12_Normal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/subtitle_font_size_large"
                android:textColor="@color/text" />
        </RelativeLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_12sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_12sdp">

        <TextView
            style="@style/Text_12_Normal"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_12sdp"
            android:text="@string/subtitle_background_color" />

        <FrameLayout
            android:id="@+id/swatch_bg_yellow"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:background="@drawable/bg_subtitle_yellow"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/_3sdp" />

        <FrameLayout
            android:id="@+id/swatch_bg_white"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:background="@drawable/bg_subtitle_white"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/_3sdp" />

        <FrameLayout
            android:id="@+id/swatch_bg_black"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:background="@drawable/bg_subtitle_black"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/_3sdp" />

        <FrameLayout
            android:id="@+id/select_none_bg"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:background="@drawable/bg_subtitle_none"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/_3sdp">

            <ImageView
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_14sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_none" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_12sdp">

        <TextView
            style="@style/Text_12_Normal"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginEnd="@dimen/_12sdp"
            android:text="@string/subtitle_text_color" />

        <FrameLayout
            android:id="@+id/swatch_text_yellow"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:background="@drawable/bg_subtitle_yellow"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/_3sdp" />

        <FrameLayout
            android:id="@+id/swatch_text_white"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:background="@drawable/bg_subtitle_white"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/_3sdp" />

        <FrameLayout
            android:id="@+id/swatch_text_black"
            android:layout_width="@dimen/_26sdp"
            android:layout_height="@dimen/_26sdp"
            android:background="@drawable/bg_subtitle_black"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/_3sdp" />
    </LinearLayout>

</LinearLayout>
