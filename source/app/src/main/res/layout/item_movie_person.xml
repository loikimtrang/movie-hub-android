<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/bg_person_item"
    android:paddingHorizontal="@dimen/_12sdp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image"
        android:layout_width="@dimen/_50sdp"
        android:layout_height="@dimen/_50sdp"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/roundImg"
        android:src="@drawable/logo"
        android:layout_marginVertical="@dimen/_6sdp"
        android:layout_marginEnd="@dimen/_12sdp"
        android:layout_centerVertical="true" />

    <LinearLayout
        android:id="@+id/l_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_toEndOf="@+id/image"
        android:layout_centerVertical="true">

        <TextView
            android:id="@+id/other_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Text_12_Bold"
            android:text="@string/name"
            />

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Text_10_Normal"
            android:text="@string/name"
            android:textColor="@color/text_cate"
            />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_un_favourite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="end"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_btn_un_favourite"
        android:paddingVertical="@dimen/_3sdp"
        android:paddingHorizontal="@dimen/_6sdp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/_12sdp"
            android:layout_height="@dimen/_12sdp"
            android:src="@drawable/ic_delete"
            android:layout_marginEnd="@dimen/_3sdp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Text_12_Normal"
            android:text="@string/not_favorite"
            android:textColor="@color/text_favourite"/>
    </LinearLayout>
</RelativeLayout>