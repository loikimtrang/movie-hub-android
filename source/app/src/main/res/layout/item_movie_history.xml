<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_episode_list"
    android:padding="@dimen/_12sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="@dimen/_80sdp"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/layout_image"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintDimensionRatio="2:3">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/movieVerticalImg"/>

            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_gravity="center_vertical">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Text_14_Normal"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/name"/>

            <TextView
                android:id="@+id/tv_sub_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Text_12_Normal"
                android:textColor="@color/text_cate"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/name"
                android:layout_marginTop="@dimen/_3sdp"/>

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="50"
                android:minHeight="@dimen/_3sdp"
                android:maxHeight="@dimen/_3sdp"
                android:progressDrawable="@drawable/seekbar_video_progress_history"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:thumb="@null"
                android:layout_marginTop="@dimen/_6sdp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/_12sdp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_season_episode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text_12_Normal"
                    android:textColor="@color/progress_history"
                    android:text="M3:T12"/>

                <ImageView
                    android:id="@+id/ic_season_dot_episode"
                    android:layout_width="@dimen/_10sdp"
                    android:layout_height="@dimen/_10sdp"
                    android:src="@drawable/ic_dot"
                    android:layout_marginHorizontal="@dimen/_2sdp"/>

                <TextView
                    android:id="@+id/tv_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text_12_Normal"
                    android:textColor="@color/progress_history"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text_10_Normal"
                    android:text="/"
                    android:textColor="@color/bg_progress_history"
                    android:layout_marginHorizontal="@dimen/_3sdp"/>

                <TextView
                    android:id="@+id/tv_total_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text_12_Normal"
                    android:text="1:55:41"
                    android:textColor="@color/bg_progress_history"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_un_favourite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_btn_un_favourite"
                android:paddingVertical="@dimen/_3sdp"
                android:paddingHorizontal="@dimen/_6sdp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/_12sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:src="@drawable/ic_delete"
                    android:layout_marginEnd="@dimen/_3sdp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text_12_Normal"
                    android:text="@string/delete"
                    android:textColor="@color/text_favourite"/>
            </LinearLayout>


        </LinearLayout>

    </LinearLayout>

</FrameLayout>
