<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="a"
            type="com.movie_hub.android.ui.main.splash.survey.SurveyActivity" />
        <variable
            name="vm"
            type="com.movie_hub.android.ui.main.splash.survey.SurveyViewModel" />
        <import type="android.view.View"/>
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_app"
        android:fitsSystemWindows="true">
        <RelativeLayout
            android:id="@+id/layout_welcome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_app">

            <ImageView
                android:id="@+id/bg_blur"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.3"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_banner_gradient_bg_app"/>

            <LinearLayout
                android:id="@+id/layout_logo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_centerInParent="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:src="@drawable/logo"
                        app:shapeAppearanceOverlay="@style/roundImg"
                        android:layout_gravity="center"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        style="@style/Text_16_Bold"
                        android:textSize="@dimen/_18ssp"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/_3sdp"/>

                </LinearLayout>



                <TextView
                    android:id="@+id/tv_welcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome"
                    style="@style/Text_16_Normal"
                    android:fontFamily="@font/bangers_regular"
                    android:textSize="@dimen/_24sdp"
                    android:gravity="center"
                    android:alpha="0"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:layout_marginBottom="@dimen/_12sdp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/viewPagerBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:clipChildren="false"
                        android:overScrollMode="never"
                        android:paddingHorizontal="@dimen/_70sdp"
                        android:layout_gravity="center"/>

                    <TextView
                        android:id="@+id/tv_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text_16_Bold"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:paddingHorizontal="@dimen/_20sdp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:gravity="center"/>

                    <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
                        android:id="@+id/dotsIndicatorBanner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/_12sdp"
                        app:dotsColor="@color/dot_un_select"
                        app:selectedDotColor="@color/white"
                        android:paddingHorizontal="@dimen/_20sdp"
                        app:dotsSize="@dimen/_8sdp"
                        app:dotsSpacing="@dimen/_3sdp"/>


                </LinearLayout>


                <FrameLayout
                    android:id="@+id/btn_continue"
                    android:layout_width="@dimen/_100sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_btn_yellow_radius_3sdp"
                    android:layout_marginTop="@dimen/_36sdp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_gravity="center">

                        <ImageView
                            android:layout_width="@dimen/_12sdp"
                            android:layout_height="@dimen/_12sdp"
                            android:src="@drawable/ic_skip"
                            android:layout_gravity="center"
                            app:tint="@color/black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/continue_"
                            style="@style/Text_12_Bold"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:layout_marginStart="@dimen/_12sdp"/>
                    </LinearLayout>

                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btn_log_out"
                    android:layout_width="@dimen/_100sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:clickable="true"
                    android:focusable="true"
                    android:onClick="onClick"
                    android:background="@drawable/bg_btn_skip"
                    android:layout_marginTop="@dimen/_12sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/log_out"
                        style="@style/Text_12_Bold"
                        android:layout_gravity="center"/>

                </FrameLayout>


            </LinearLayout>



        </RelativeLayout>

        <FrameLayout
            android:id="@+id/layout_survey"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_app"
            android:visibility="gone">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/layout_logo_survey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:layout_marginHorizontal="@dimen/_20sdp">

                    <ImageView
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:src="@drawable/logo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        style="@style/Text_14_Bold"/>


                </LinearLayout>

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:layout_below="@+id/layout_logo_survey"
                    style="@style/Text_16_Bold"
                    android:text="@string/survey_title"/>

                <TextView
                    android:id="@+id/description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text_12_Normal"
                    android:textColor="@color/text_gray"
                    android:text="@string/survey_description"
                    android:layout_below="@+id/title"
                    android:layout_marginHorizontal="@dimen/_20sdp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/rv_survey"
                    android:layout_below="@+id/description"
                    android:layout_above="@+id/layout_bottom"
                    android:layout_marginVertical="@dimen/_12sdp"
                    android:layout_marginHorizontal="@dimen/_12sdp"/>

                <LinearLayout
                    android:id="@+id/layout_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:orientation="vertical"
                    android:layout_marginBottom="@dimen/_30sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_20sdp"
                        android:layout_marginBottom="@dimen/_6sdp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/selected_count"
                            style="@style/Text_12_Normal"/>

                        <TextView
                            android:id="@+id/count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            style="@style/Text_12_Bold"
                            android:layout_marginStart="@dimen/_3sdp"/>
                    </LinearLayout>


                    <FrameLayout
                        android:id="@+id/btn_done"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_36sdp"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"

                        android:background="@drawable/bg_btn_yellow_radius_3sdp"
                        android:layout_marginHorizontal="@dimen/_20sdp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/finish"
                                style="@style/Text_14_Bold"
                                android:textColor="@color/black"
                                android:gravity="center"/>
                        </LinearLayout>

                    </FrameLayout>

                </LinearLayout>

            </RelativeLayout>

        </FrameLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/bottom_loading_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:indeterminate="true"
            android:visibility="gone"
            app:trackThickness="1dp"
            app:indicatorColor="@color/ic_tab_bar_tint"
            app:trackColor="@android:color/transparent"
            style="@style/Widget.MaterialComponents.LinearProgressIndicator"
            android:layout_marginBottom="@dimen/_90sdp"/>

        <FrameLayout
            android:id="@+id/loading_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"/>
    </FrameLayout>

</layout>

