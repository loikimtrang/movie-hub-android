<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="vm"
            type="com.movie_hub.android.ui.main.movie.watch.WatchMovieViewModel" />

        <variable
            name="a"
            type="com.movie_hub.android.ui.main.movie.watch.WatchMovieActivity" />

        <import type="android.view.View" />

    </data>

    <LinearLayout
        android:id="@+id/list_episode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg_list_episode"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_60sdp">

            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_12sdp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/btn_close_episodes"/>

            <FrameLayout
                android:id="@+id/btn_close_episodes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/_14sdp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:onClick="onClick"
                tools:ignore="UsingOnClickInXml">
                <ImageView
                    android:layout_width="@dimen/_14sdp"
                    android:layout_height="@dimen/_14sdp"
                    android:src="@drawable/ic_x"/>
            </FrameLayout>

        </RelativeLayout>

    </LinearLayout>

</layout>
