<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fitsSystemWindows="false"
    android:paddingBottom="@dimen/_12sdp"
    android:background="@android:color/transparent"
    android:id="@+id/layout_setting">

    <LinearLayout
        android:id="@+id/speed_layout"
        android:layout_width="@dimen/_280sdp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_setting_video"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_14sdp"
            android:src="@drawable/ic_remove"
            android:layout_gravity="center_horizontal"/>

        <TextView
            android:id="@+id/tv_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Text_16_Normal"
            android:layout_gravity="center"
            android:text="1.00x"
            android:layout_marginBottom="@dimen/_6sdp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/_6sdp"
            android:paddingHorizontal="@dimen/_12sdp">

            <FrameLayout
                android:id="@+id/btn_minus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_setting_plus_minus_speed">

                <ImageView
                    android:layout_width="@dimen/_14sdp"
                    android:layout_height="@dimen/_14sdp"
                    android:src="@drawable/ic_minus_speed"
                    android:layout_margin="@dimen/_6sdp"/>

            </FrameLayout>

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="50"
                android:minHeight="@dimen/_3sdp"
                android:maxHeight="@dimen/_3sdp"
                android:progressDrawable="@drawable/seekbar_play_speed_progress"
                android:thumb="@drawable/seekbar_play_speed_thumb"
                android:layout_marginHorizontal="@dimen/_6sdp"/>

            <FrameLayout
                android:id="@+id/btn_plus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_setting_plus_minus_speed">

                <ImageView
                    android:layout_width="@dimen/_14sdp"
                    android:layout_height="@dimen/_14sdp"
                    android:src="@drawable/ic_plus"
                    android:layout_margin="@dimen/_6sdp"/>

            </FrameLayout>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="@dimen/_8sdp"
            android:paddingHorizontal="@dimen/_12sdp">

            <RelativeLayout
                android:id="@+id/speed_100"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_setting_play_speed_item"
                android:layout_weight="1"
                android:layout_margin="@dimen/_3sdp"
                android:padding="@dimen/_3sdp">

                <TextView
                    style="@style/Text_12_Normal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/_6sdp"
                    android:paddingVertical="@dimen/_3sdp"
                    android:text="1.0x"
                    android:textColor="@color/text"
                    android:gravity="center"/>


            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/speed_125"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_setting_play_speed_item"
                android:layout_weight="1"
                android:layout_margin="@dimen/_3sdp"
                android:padding="@dimen/_3sdp">

                <TextView
                    style="@style/Text_12_Normal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/_6sdp"
                    android:paddingVertical="@dimen/_3sdp"
                    android:text="1.25x"
                    android:textColor="@color/text"
                    android:gravity="center"/>


            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/speed_150"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_setting_play_speed_item"
                android:layout_weight="1"
                android:layout_margin="@dimen/_3sdp"
                android:padding="@dimen/_3sdp">

                <TextView
                    style="@style/Text_12_Normal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/_6sdp"
                    android:paddingVertical="@dimen/_3sdp"
                    android:text="1.5x"
                    android:textColor="@color/text"
                    android:gravity="center"/>


            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/speed_200"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_setting_play_speed_item"
                android:layout_weight="1"
                android:layout_margin="@dimen/_3sdp"
                android:padding="@dimen/_3sdp">

                <TextView
                    style="@style/Text_12_Normal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/_6sdp"
                    android:paddingVertical="@dimen/_3sdp"
                    android:text="2.0x"
                    android:textColor="@color/text"
                    android:gravity="center"/>


            </RelativeLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>