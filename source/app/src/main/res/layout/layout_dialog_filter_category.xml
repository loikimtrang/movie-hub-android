<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:background="@android:color/transparent"
    android:id="@+id/layout_setting"
    android:windowIsFloating="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_choose_season">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_choose_season"
            android:orientation="vertical"
            android:focusableInTouchMode="true"
            android:paddingTop="@dimen/_12sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/layout_content"
                android:background="@drawable/bg_choose_season">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginHorizontal="@dimen/_12sdp">

                    <ImageView
                        android:layout_width="@dimen/_10sdp"
                        android:layout_height="@dimen/_10sdp"
                        android:src="@drawable/ic_filter"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text_12_Normal"
                        android:text="@string/filter"
                        android:layout_marginStart="@dimen/_6sdp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/_6sdp"
                    android:paddingHorizontal="@dimen/_12sdp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text_12_Normal"
                            android:text="@string/filter_category"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:gravity="center_vertical"
                            android:paddingVertical="@dimen/_6sdp"
                            android:paddingHorizontal="@dimen/_12sdp">

                            <TextView
                                android:id="@+id/tv_cate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/Text_12_Normal"/>


                        </LinearLayout>

                    </RelativeLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_filter_category"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_240sdp"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:visibility="visible"/>

                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btn_filter"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:background="@drawable/bg_btn_white_radius_3sdp"
                    android:clickable="true"
                    android:focusable="true"
                    android:onClick="onClick"
                    android:foreground="?attr/selectableItemBackground"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:layout_marginVertical="@dimen/_20sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        style="@style/Text_12_Bold"
                        android:text="@string/filter_results"
                        android:textColor="@color/black"
                        />

                </FrameLayout>

            </LinearLayout>

        </RelativeLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_6sdp"
            android:layout_gravity="end"
            android:layout_margin="@dimen/_6sdp"
            android:background="@drawable/bg_btn_press_tran"
            android:clickable="true"
            android:focusable="true"
            android:id="@+id/btn_close">
            <ImageView
                android:layout_width="@dimen/_12sdp"
                android:layout_height="@dimen/_12sdp"
                android:src="@drawable/ic_close"/>
        </FrameLayout>
    </FrameLayout>




</FrameLayout>