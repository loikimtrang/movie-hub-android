<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    >


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:id="@+id/scrollView">

        <LinearLayout
            android:id="@+id/layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/bg_app"
            android:clickable="true">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sign_in"
                style="@style/Text_14_Bold"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/_12sdp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_6sdp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/if_you_already_have_an_account"
                    style="@style/Text_10_Normal"
                    android:textColor="@color/text_gray"/>


                <TextView
                    android:id="@+id/loginNow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/log_in_now"
                    style="@style/Text_10_Normal"
                    android:textColor="@color/btn_login"
                    android:layout_marginStart="@dimen/_3sdp"/>

            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/CustomOutlinedBox"
                app:endIconMode="custom"
                android:layout_marginHorizontal="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_6sdp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/username"
                    style="@style/Text_12_Normal"
                    android:clickable="true"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/CustomOutlinedBox"
                app:endIconMode="custom"
                android:layout_marginHorizontal="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_6sdp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/enter_your_email"
                    style="@style/Text_12_Normal"
                    android:clickable="true"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:inputType="textEmailAddress"
                    />
            </com.google.android.material.textfield.TextInputLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/CustomOutlinedBox"
                    app:endIconMode="custom"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:layout_marginTop="@dimen/_6sdp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/enter_your_password"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        style="@style/Text_12_Normal"
                        android:paddingHorizontal="@dimen/_12sdp"/>
                </com.google.android.material.textfield.TextInputLayout>


                <FrameLayout
                    android:id="@+id/hide_password"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="@dimen/_20sdp">
                    <ImageView
                        android:id="@+id/iv_toggle_password"
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:src="@drawable/ic_eye_hidden"
                        android:layout_marginHorizontal="@dimen/_6sdp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginTop="@dimen/_5sdp"/>
                </FrameLayout>


            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/CustomOutlinedBox"
                    app:endIconMode="custom"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:layout_marginTop="@dimen/_6sdp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/re_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/confirm_your_password"
                        style="@style/Text_12_Normal"
                        android:clickable="true"
                        android:paddingHorizontal="@dimen/_12sdp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:inputType="textPassword"
                        />
                </com.google.android.material.textfield.TextInputLayout>

                <FrameLayout
                    android:id="@+id/hide_re_password"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="@dimen/_20sdp">
                    <ImageView
                        android:id="@+id/iv_toggle_re_password"
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:src="@drawable/ic_eye_hidden"
                        android:layout_marginHorizontal="@dimen/_6sdp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginTop="@dimen/_5sdp"/>
                </FrameLayout>
            </FrameLayout>


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_36sdp"
                android:layout_marginHorizontal="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_16sdp"
                android:layout_marginBottom="@dimen/_40sdp">
                <TextView
                    android:id="@+id/register"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_btn_yellow_radius_6sdp"
                    android:text="@string/sign_in"
                    style="@style/Text_12_Bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"/>

                <ProgressBar
                    android:id="@+id/register_loading"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_gravity="center"
                    android:visibility="invisible"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/black" />
            </FrameLayout>
            


        </LinearLayout>

    </ScrollView>

</FrameLayout>
