<?xml version="1.0" encoding="utf-8"?>

<com.facebook.shimmer.ShimmerFrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmerLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/_12sdp"
    android:background="@android:color/transparent"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="false"
    android:focusable="false">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/image"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/roundImg"
                android:background="@drawable/bg_shimmer_radius_6sdp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/image"
                android:layout_marginStart="@dimen/_12sdp"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@+id/tv_time">

                        <TextView
                            android:id="@+id/tv_name_author"
                            style="@style/Text_10_Bold"
                            android:layout_width="@dimen/_100sdp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_shimmer_radius_3sdp"
                            android:ellipsize="end"
                            android:maxLines="1" />

                    </LinearLayout>



                    <TextView
                        android:id="@+id/tv_time"
                        android:layout_width="@dimen/_60sdp"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        style="@style/Text_10_Normal"
                        android:background="@drawable/bg_shimmer_radius_3sdp"
                        android:layout_alignParentEnd="true"
                        android:layout_marginStart="@dimen/_6sdp"/>

                </RelativeLayout>

                <TextView
                    android:id="@+id/tv_content"
                    android:layout_width="@dimen/_180sdp"
                    android:layout_height="@dimen/_30sdp"
                    style="@style/Text_10_Normal"
                    android:layout_marginVertical="@dimen/_6sdp"
                    android:background="@drawable/bg_shimmer_radius_6sdp"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="@dimen/_120sdp"
                        android:layout_height="@dimen/_14sdp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_shimmer_radius_3sdp">

                    </LinearLayout>

                </RelativeLayout>

            </LinearLayout>


        </RelativeLayout>

    </FrameLayout>


</com.facebook.shimmer.ShimmerFrameLayout>
