<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/_12sdp"
    android:clickable="true"
    android:focusable="true"
    android:background="@color/bg_comment">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/roundImg"
            android:src="@drawable/logo"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/image"
            android:layout_marginStart="@dimen/_12sdp"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@+id/tv_time">
                    <TextView
                        android:id="@+id/tv_name_author"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="name"
                        style="@style/Text_10_Bold"/>

                    <ImageView
                        android:id="@+id/ic_pin"
                        android:layout_width="@dimen/_10sdp"
                        android:layout_height="@dimen/_10sdp"
                        android:src="@drawable/ic_pin"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/_3sdp"/>

                    <FrameLayout
                        android:id="@+id/layout_tag_episode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tag_episode_comment"
                        android:paddingVertical="@dimen/_1sdp"
                        android:paddingHorizontal="@dimen/_3sdp"
                        android:layout_marginStart="@dimen/_12sdp"
                        android:visibility="gone"
                        android:layout_gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_episode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text_10_Normal"
                            android:textColor="@color/text_time_comment"
                            android:text="E2:12"/>

                    </FrameLayout>

                </LinearLayout>



                <TextView
                    android:id="@+id/tv_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="4 phút trước"
                    style="@style/Text_10_Normal"
                    android:textColor="@color/text_time_comment"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="@dimen/_6sdp"/>

            </RelativeLayout>

            <TextView
                android:id="@+id/tv_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Text_10_Normal"
                android:layout_marginVertical="@dimen/_6sdp"
                android:textColor="@color/text_comment"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:id="@+id/btn_like"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_btn_press_tran"
                        android:padding="@dimen/_8sdp"
                        android:clickable="true"
                        android:focusable="true"
                        android:clipToPadding="true">

                        <ImageView
                            android:id="@+id/ic_like"
                            android:layout_width="@dimen/_12sdp"
                            android:layout_height="@dimen/_12sdp"
                            android:src="@drawable/ic_like"/>

                    </FrameLayout>


                    <TextView
                        android:id="@+id/tv_count_like"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text_10_Normal"
                        android:layout_marginVertical="@dimen/_6sdp"
                        android:textColor="@color/text_comment"
                        android:text="1"
                        android:layout_marginStart="@dimen/_3sdp"/>


                    <FrameLayout
                        android:id="@+id/btn_dis_like"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_btn_press_tran"
                        android:padding="@dimen/_8sdp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginStart="@dimen/_6sdp">

                        <ImageView
                            android:id="@+id/ic_dis_like"
                            android:layout_width="@dimen/_12sdp"
                            android:layout_height="@dimen/_12sdp"
                            android:src="@drawable/ic_dislike"/>

                    </FrameLayout>


                    <TextView
                        android:id="@+id/tv_count_dis_like"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text_10_Normal"
                        android:layout_marginVertical="@dimen/_6sdp"
                        android:textColor="@color/text_comment"
                        android:text="1"
                        android:layout_marginStart="@dimen/_3sdp"/>

                    <FrameLayout
                        android:id="@+id/btn_reply"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_btn_press_tran"
                        android:padding="@dimen/_4sdp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginStart="@dimen/_6sdp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/_10sdp"
                                android:layout_height="@dimen/_10sdp"
                                android:src="@drawable/ic_reply"
                                android:layout_gravity="center_vertical"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/Text_10_Normal"
                                android:textColor="@color/text_comment"
                                android:text="@string/reply"
                                android:layout_marginStart="@dimen/_3sdp" />
                        </LinearLayout>

                    </FrameLayout>

                </LinearLayout>

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/btn_open_comment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/_6sdp"
                android:orientation="horizontal"
                android:padding="@dimen/_5sdp"
                android:gravity="center_vertical"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/ic_open_child_comment"
                    android:layout_width="@dimen/_8sdp"
                    android:layout_height="@dimen/_8sdp"
                    android:src="@drawable/ic_open_child_comment"
                    android:layout_marginTop="@dimen/_1sdp"/>

                <TextView
                    android:id="@+id/tv_open_child_comment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text_10_Normal"
                    android:textColor="@color/text_more_comment"
                    android:text="@string/comment"
                    android:layout_marginStart="@dimen/_6sdp"/>

            </LinearLayout>


            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/child_comment"
                android:layout_marginTop="@dimen/_6sdp"
                android:visibility="visible"
                android:animateLayoutChanges="false"/>

        </LinearLayout>


    </RelativeLayout>

</FrameLayout>
