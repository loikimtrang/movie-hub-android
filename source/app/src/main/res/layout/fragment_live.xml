<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="f"
            type="com.movie_hub.android.ui.main.live.LiveFragment"/>
        <variable
            name="vm"
            type="com.movie_hub.android.ui.main.live.LiveViewModel"/>

        <import type="android.view.View"/>
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg_app">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/layout_header"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"
                android:background="@color/header_app">

                <FrameLayout
                    android:id="@+id/btn_search"
                    android:layout_width="@dimen/_36sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_alignParentStart="true">
                    <ImageView
                        android:layout_width="@dimen/_14sdp"
                        android:layout_height="@dimen/_14sdp"
                        android:src="@drawable/ic_search"
                        android:layout_gravity="center"/>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/watch_together"
                    style="@style/Text_14_Bold"
                    android:layout_centerInParent="true"
                    />

                <FrameLayout
                    android:id="@+id/option"
                    android:layout_width="@dimen/_36sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_alignParentEnd="true">
                    <ImageView
                        android:layout_width="@dimen/_12sdp"
                        android:layout_height="@dimen/_12sdp"
                        android:src="@drawable/ic_option_filter"
                        android:layout_gravity="center"/>
                </FrameLayout>

            </RelativeLayout>

            <FrameLayout
                android:id="@+id/layout_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/header_app"
                android:visibility="gone">

                <EditText
                    android:id="@+id/edt_search_room"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_26sdp"
                    android:background="@drawable/bg_search_bar"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:layout_marginBottom="@dimen/_12sdp"
                    android:gravity="center|start"
                    style="@style/Text_12_Normal"
                    android:singleLine="true"
                    android:drawableStart="@drawable/ic_search_bar"
                    android:drawableEnd="@drawable/ic_clear"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:drawablePadding="@dimen/_12sdp"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:hint="@string/hint_enter_room_code"
                    android:textColorHint="@color/text_cate"/>

            </FrameLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/rv_type"
                android:paddingVertical="@dimen/_6sdp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/swipeRefreshLayout">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_room"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>

                        <FrameLayout
                            android:id="@+id/layout_empty"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/bg_app"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_gravity="center|top"
                                android:layout_marginTop="@dimen/_84sdp"
                                android:visibility="visible">
                                <ImageView
                                    android:layout_width="@dimen/_60sdp"
                                    android:layout_height="@dimen/_60sdp"
                                    android:src="@drawable/ic_empty"
                                    android:layout_gravity="center"/>

                                <TextView
                                    android:id="@+id/tv_empty"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/Text_12_Normal"
                                    android:text="@string/empty_room"
                                    android:textColor="@color/text_empty"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="@dimen/_6sdp"/>
                            </LinearLayout>

                        </FrameLayout>
                    </FrameLayout>




                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            </FrameLayout>

        </LinearLayout>


    </FrameLayout>
</layout>