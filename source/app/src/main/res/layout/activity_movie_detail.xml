<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="a"
            type="com.movie_hub.android.ui.main.movie.detail.MovieDetailActivity" />
        <variable
            name="vm"
            type="com.movie_hub.android.ui.main.movie.detail.MovieDetailViewModel" />
        <import type="android.view.View" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:background="@color/bg_app">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/_1sdp">

            <FrameLayout
                android:id="@+id/layout_trailer_poster"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.movie_hub.android.ui.main.custom.RatioFrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_collapseMode="parallax">

                    <androidx.media3.ui.PlayerView
                        android:id="@+id/trailer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:use_controller="false"/>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <FrameLayout
                            android:id="@+id/controlVideo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone"
                            android:background="@drawable/bg_control_video">

                            <FrameLayout
                                android:id="@+id/btn_play_pause"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_play_pause_circle"
                                android:clickable="true"
                                android:focusable="true"
                                android:onClick="onClick"
                                tools:ignore="UsingOnClickInXml"
                                android:layout_gravity="center">

                                <ImageView
                                    android:id="@+id/ic_play_pause"
                                    android:layout_width="@dimen/_18sdp"
                                    android:layout_height="@dimen/_18sdp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:src="@drawable/ic_play"
                                    android:layout_margin="@dimen/_8sdp"
                                    android:layout_gravity="center"/>
                            </FrameLayout>

                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/layout_seek_bar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="bottom"
                            android:layout_gravity="bottom">

                            <SeekBar
                                android:id="@+id/seekBar"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:max="1000"
                                android:progress="0"
                                android:minHeight="@dimen/_3sdp"
                                android:maxHeight="@dimen/_3sdp"
                                android:progressDrawable="@drawable/seekbar_video_progress_non_radius"
                                android:paddingTop="@dimen/_8sdp"
                                android:paddingStart="0dp"
                                tools:ignore="RtlSymmetry"
                                android:paddingEnd="0dp"
                                android:thumb="@null"/>

                        </LinearLayout>

                    </FrameLayout>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/btn_mute"
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        app:cardCornerRadius="@dimen/_16sdp"
                        app:cardBackgroundColor="@color/black"
                        app:cardElevation="0dp"
                        android:onClick="@{(v) -> a.onClick(v)}"
                        android:layout_gravity="end|bottom"
                        android:layout_marginBottom="@dimen/_24sdp"
                        android:layout_marginEnd="@dimen/_6sdp"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/ic_mute"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_volume_mute"
                            android:scaleType="centerInside"
                            android:layout_margin="@dimen/_6sdp"/>

                    </androidx.cardview.widget.CardView>

                    <FrameLayout
                        android:id="@+id/layout_poster"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/account_header">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:id="@+id/img_poster"
                            android:clickable="false"
                            android:focusable="false"/>
                    </FrameLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_control_video"
                        android:visibility="gone"
                        android:id="@+id/layout_replay">

                        <FrameLayout
                            android:id="@+id/btn_replay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_btn_replay"
                            android:clickable="true"
                            android:focusable="true"
                            tools:ignore="UsingOnClickInXml"
                            android:onClick="onClick"
                            android:layout_centerInParent="true">

                            <ImageView
                                android:id="@+id/ic_replay"
                                android:layout_width="@dimen/_30sdp"
                                android:layout_height="@dimen/_30sdp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@drawable/ic_replay"
                                android:layout_margin="@dimen/_6sdp"/>

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text_12_Bold"
                            android:text="@string/replay"
                            android:layout_centerHorizontal="true"
                            android:layout_below="@id/btn_replay"
                            android:layout_marginTop="@dimen/_3sdp"
                            android:visibility="gone"/>

                    </RelativeLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/btn_close"
                            android:layout_width="@dimen/_32sdp"
                            android:layout_height="@dimen/_32sdp"
                            app:cardCornerRadius="@dimen/_16sdp"
                            app:cardBackgroundColor="@color/bg_close"
                            app:cardElevation="0dp"
                            android:layout_margin="@dimen/_6sdp"
                            android:onClick="@{(v) -> a.onClick(v)}">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_close"
                                android:scaleType="centerInside"
                                android:layout_margin="@dimen/_3sdp"/>
                        </androidx.cardview.widget.CardView>


                    </FrameLayout>

                    <ProgressBar
                        android:id="@+id/loading_progress"
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:visibility="gone"
                        style="@style/Widget.AppCompat.ProgressBar"
                        android:indeterminateDrawable="@drawable/loading_video_progress"
                        />

                </com.movie_hub.android.ui.main.custom.RatioFrameLayout>

            </FrameLayout>

            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg_app"
                android:layout_below="@+id/layout_trailer_poster">

                <com.google.android.material.appbar.AppBarLayout
                    android:id="@+id/appBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

                    <include
                        layout="@layout/layout_movie_detail_header"
                        android:id="@+id/includeMovieHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:vm="@{vm}"
                        app:a="@{a}"
                        app:layout_scrollFlags="scroll|exitUntilCollapsed"
                        />

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/subTabLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/account_header"
                        app:layout_scrollFlags="enterAlways"
                        app:tabIndicatorColor="@color/tab_select"
                        app:tabSelectedTextColor="@color/tab_select"
                        app:tabTextColor="@color/tab_un_select"
                        app:tabTextAppearance="@style/Text_12_Normal"
                        app:tabIndicatorFullWidth="false" />

                </com.google.android.material.appbar.AppBarLayout>


                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/subViewPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior"
                    android:overScrollMode="never"
                    android:nestedScrollingEnabled="true" />

            </androidx.coordinatorlayout.widget.CoordinatorLayout>

        </RelativeLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/bottom_loading_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:indeterminate="true"
            android:visibility="gone"
            app:trackThickness="1dp"
            app:indicatorColor="@color/ic_tab_bar_tint"
            app:trackColor="@android:color/transparent"
            style="@style/Widget.MaterialComponents.LinearProgressIndicator"/>
        <FrameLayout
            android:id="@+id/loading_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"/>

    </FrameLayout>


</layout>
