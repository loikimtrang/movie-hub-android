<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="a"
            type="com.movie_hub.android.ui.main.movie.watch.WatchMovieActivity" />
        <variable
            name="vm"
            type="com.movie_hub.android.ui.main.movie.watch.WatchMovieViewModel" />
        <import type="android.view.View"/>
    </data>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/bg_app"
        android:fitsSystemWindows="false">


        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="false"/>

        <FrameLayout
            android:id="@+id/control_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="@drawable/bg_control_video">
            <FrameLayout
                android:id="@+id/button_control_video"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top"
                        android:layout_margin="@dimen/_12sdp">

                        <FrameLayout
                            android:id="@+id/btn_close"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:onClick="@{(v)->a.onClick(v)}"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentTop="true"
                            android:padding="@dimen/_12sdp"
                            android:background="@drawable/bg_play_pause_circle">

                            <ImageView
                                android:layout_width="@dimen/_12sdp"
                                android:layout_height="@dimen/_12sdp"
                                android:layout_gravity="center"
                                android:rotation="180"
                                android:src="@drawable/ic_arrow_right" />
                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/btn_lock_screen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:padding="@dimen/_8sdp"
                            android:onClick="onClick"
                            tools:ignore="UsingOnClickInXml"
                            android:background="@drawable/bg_play_pause_circle"
                            android:layout_toEndOf="@id/btn_close"
                            android:layout_marginHorizontal="@dimen/_6sdp"
                            android:layout_centerVertical="true">

                            <ImageView
                                android:id="@+id/ic_lock_screen"
                                android:layout_width="@dimen/_20sdp"
                                android:layout_height="@dimen/_20sdp"
                                android:src="@drawable/ic_lock_screen"/>

                        </FrameLayout>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginHorizontal="@dimen/_6sdp"
                            android:orientation="vertical"
                            tools:ignore="RtlHardcoded"
                            android:layout_toEndOf="@+id/btn_lock_screen"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@id/btn_setting">

                            <TextView
                                android:id="@+id/name_movie"
                                style="@style/Text_12_Bold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="2"
                                android:text="Name" />

                            <TextView
                                android:id="@+id/name_movie_original"
                                style="@style/Text_12_Normal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="2"
                                android:text="Name" />
                        </LinearLayout>

                        <FrameLayout
                            android:id="@+id/btn_setting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:padding="@dimen/_6sdp"
                            android:onClick="onClick"
                            tools:ignore="UsingOnClickInXml"
                            android:background="@drawable/bg_play_pause_circle"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true">

                            <ImageView
                                android:layout_width="@dimen/_20sdp"
                                android:layout_height="@dimen/_20sdp"
                                android:src="@drawable/ic_setting_video"/>

                        </FrameLayout>
                    </RelativeLayout>

                </FrameLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:paddingBottom="@dimen/_8sdp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_bottom_control"
                        android:paddingHorizontal="@dimen/_6sdp"
                        android:gravity="center"
                        android:clickable="false"
                        android:focusable="false"
                        android:paddingVertical="@dimen/_6sdp">

                        <LinearLayout
                            android:id="@+id/btn_audio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:paddingVertical="@dimen/_8sdp"
                            android:paddingHorizontal="@dimen/_6sdp"
                            android:layout_gravity="center"
                            android:clickable="true"
                            android:focusable="true"
                            android:onClick="onClick"
                            android:background="?attr/selectableItemBackgroundBorderless">

                            <ImageView
                                android:layout_width="@dimen/_16sdp"
                                android:layout_height="@dimen/_16sdp"
                                android:src="@drawable/ic_microphone"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/Text_14_Normal"
                                android:text="@string/audio_language"
                                android:layout_marginStart="@dimen/_6sdp"/>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btn_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:paddingVertical="@dimen/_8sdp"
                            android:paddingHorizontal="@dimen/_6sdp"
                            android:layout_gravity="center"
                            android:clickable="true"
                            android:focusable="true"
                            android:onClick="onClick"
                            android:background="?attr/selectableItemBackgroundBorderless">

                            <ImageView
                                android:layout_width="@dimen/_18sdp"
                                android:layout_height="@dimen/_18sdp"
                                android:src="@drawable/ic_subtitle_off"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/Text_14_Normal"
                                android:text="@string/subtitle"
                                android:layout_marginStart="@dimen/_6sdp"/>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btn_episodes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:paddingVertical="@dimen/_8sdp"
                            android:paddingHorizontal="@dimen/_6sdp"
                            android:layout_gravity="center"
                            android:clickable="true"
                            android:focusable="true"
                            android:onClick="onClick"
                            android:background="?attr/selectableItemBackgroundBorderless">

                            <ImageView
                                android:layout_width="@dimen/_18sdp"
                                android:layout_height="@dimen/_18sdp"
                                android:src="@drawable/ic_list_episode"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/Text_14_Normal"
                                android:text="@string/episodes"
                                android:layout_marginStart="@dimen/_6sdp"/>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btn_next_episode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:paddingVertical="@dimen/_8sdp"
                            android:paddingHorizontal="@dimen/_6sdp"
                            android:layout_gravity="center"
                            android:clickable="true"
                            android:focusable="true"
                            android:onClick="onClick"
                            android:background="?attr/selectableItemBackgroundBorderless">

                            <ImageView
                                android:layout_width="@dimen/_18sdp"
                                android:layout_height="@dimen/_18sdp"
                                android:src="@drawable/ic_next_episode"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/Text_14_Normal"
                                android:text="@string/next_episode"
                                android:layout_marginStart="@dimen/_6sdp"/>

                        </LinearLayout>

                    </LinearLayout>

                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btn_previous"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_play_pause_circle"
                    android:clickable="true"
                    android:focusable="true"
                    android:onClick="onClick"
                    tools:ignore="UsingOnClickInXml"
                    android:layout_marginEnd="@dimen/_90sdp"
                    android:layout_gravity="center">

                    <ImageView
                        android:id="@+id/ic_previous_looping"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:src="@drawable/ic_previous_looping"
                        android:layout_margin="@dimen/_8sdp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10"
                        android:layout_gravity="center"
                        style="@style/Text_14_Bold"/>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btn_forward"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_play_pause_circle"
                    android:clickable="true"
                    android:focusable="true"
                    android:onClick="onClick"
                    tools:ignore="UsingOnClickInXml"
                    android:layout_marginStart="@dimen/_90sdp"
                    android:layout_gravity="center">

                    <ImageView
                        android:id="@+id/ic_forward_looping"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:src="@drawable/ic_forward_looping"
                        android:layout_margin="@dimen/_8sdp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10"
                        android:layout_gravity="center"
                        style="@style/Text_14_Bold"/>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:id="@+id/btn_play_pause"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_play_pause_circle"
                        android:clickable="true"
                        android:focusable="true"
                        android:onClick="onClick"
                        tools:ignore="UsingOnClickInXml">

                        <ImageView
                            android:id="@+id/ic_play_pause"
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="@dimen/_30sdp"
                            android:src="@drawable/ic_pause"
                            android:layout_margin="@dimen/_12sdp"/>
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btn_replay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_play_pause_circle"
                        android:clickable="true"
                        android:focusable="true"
                        tools:ignore="UsingOnClickInXml"
                        android:onClick="onClick"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_36sdp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_replay"
                            android:layout_margin="@dimen/_6sdp"/>
                    </FrameLayout>

                </LinearLayout>

            </FrameLayout>

            <LinearLayout
                android:id="@+id/btn_un_lock_screen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                tools:ignore="UsingOnClickInXml"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_btn_white_radius_6sdp"
                android:padding="@dimen/_6sdp"
                android:layout_gravity="center|bottom"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/_50sdp">

                <ImageView
                    android:id="@+id/ic_un_lock_screen"
                    android:layout_width="@dimen/_12sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:src="@drawable/ic_unlock_screen"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text_12_Normal"
                    android:text="@string/unlock_screen"
                    android:textColor="@color/black"
                    android:layout_marginStart="@dimen/_6sdp"/>

            </LinearLayout>

        </FrameLayout>

        <RelativeLayout
            android:id="@+id/layout_brightness"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start|center_vertical"
            android:visibility="gone"
            android:padding="@dimen/_8sdp"
            android:clickable="false"
            android:focusable="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/icBrightness"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:src="@drawable/ic_brightness_medium"
                    android:layout_marginStart="@dimen/_12sdp"/>

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_120sdp"
                    android:rotation="270"
                    android:layout_gravity="center_vertical"
                    android:clickable="false"
                    android:focusable="false">

                    <SeekBar
                        android:id="@+id/seekBrightness"
                        android:layout_width="@dimen/_120sdp"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="50"
                        android:minHeight="@dimen/_6sdp"
                        android:maxHeight="@dimen/_6sdp"
                        android:thumb="@null"
                        android:progressDrawable="@drawable/seekbar_brightness_progress"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="@dimen/_8sdp"
                        android:layout_marginTop="@dimen/_11sdp"/>
                </FrameLayout>
            </LinearLayout>



        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/layout_volume"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:visibility="gone"
            android:padding="@dimen/_8sdp"
            android:clickable="false"
            android:focusable="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/icVolume"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:src="@drawable/ic_volume_low"
                    android:layout_marginEnd="@dimen/_12sdp"
                    android:layout_gravity="end"/>

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_120sdp"
                    android:rotation="270"
                    android:layout_gravity="center_vertical"
                    android:clickable="false"
                    android:focusable="false">

                    <SeekBar
                        android:id="@+id/seekVolume"
                        android:layout_width="@dimen/_120sdp"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="50"
                        android:minHeight="@dimen/_6sdp"
                        android:maxHeight="@dimen/_6sdp"
                        android:thumb="@null"
                        android:progressDrawable="@drawable/seekbar_brightness_progress"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="@dimen/_8sdp"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="@dimen/_11sdp"/>
                </FrameLayout>
            </LinearLayout>



        </RelativeLayout>

        <LinearLayout
            android:id="@+id/layout_seek_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingVertical="@dimen/_12sdp"
            android:layout_marginBottom="@dimen/_52sdp"
            android:visibility="gone"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/thumbnail_preview_container"
                android:layout_width="@dimen/_200sdp"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:background="@android:color/transparent"
                android:layout_marginBottom="@dimen/_12sdp">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintDimensionRatio="16:9"
                    android:clipChildren="false">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_thumbnail_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/movieVerticalImg"/>

                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- SeekBar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_current_time"
                    android:layout_width="@dimen/_60sdp"
                    android:layout_height="wrap_content"
                    android:text="00:00:00"
                    style="@style/Text_12_Normal"
                    android:textColor="@android:color/white"
                    android:gravity="center"/>

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progress="0"
                    android:minHeight="@dimen/_3sdp"
                    android:maxHeight="@dimen/_3sdp"
                    android:progressDrawable="@drawable/seekbar_video_progress"
                    android:thumb="@drawable/seekbar_video_thumb"
                    android:paddingStart="@dimen/_8sdp"
                    android:paddingEnd="@dimen/_8sdp"
                    android:paddingVertical="@dimen/_6sdp"/>

                <TextView
                    android:id="@+id/tv_total_time"
                    android:layout_width="@dimen/_60sdp"
                    android:layout_height="wrap_content"
                    android:text="00:00:00"
                    style="@style/Text_12_Normal"
                    android:textColor="@android:color/white"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- Thumbnail Preview - CHỒNG LÊN TRÊN SEEK BAR -->

        </LinearLayout>


        <LinearLayout
            android:id="@+id/layout_count_previous"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:ignore="UsingOnClickInXml"
            android:paddingStart="@dimen/_60sdp"
            android:layout_gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ic_previous"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_previous"
                android:layout_margin="@dimen/_6sdp"/>

            <TextView
                android:id="@+id/tv_count_previous"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="- 10"
                android:layout_gravity="center"
                style="@style/Text_14_Bold"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_count_forward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:ignore="UsingOnClickInXml"
            android:layout_gravity="center_vertical|end"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone"
            android:paddingEnd="@dimen/_60sdp">

            <TextView
                android:id="@+id/tv_count_forward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ 10"
                android:layout_gravity="center"
                style="@style/Text_14_Bold"/>

            <ImageView
                android:id="@+id/ic_forward"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_forward"
                android:layout_margin="@dimen/_6sdp"/>


        </LinearLayout>

        <include
            layout="@layout/layout_list_episodes"
            android:id="@+id/layout_list_episodes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:vm="@{vm}"
            app:a="@{a}"
            />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/_16sdp"
            android:background="@drawable/bg_speed_press"
            android:padding="@dimen/_3sdp"
            android:gravity="center"
            android:id="@+id/layout_speed_press"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Text_8_Normal"
                android:text="2.0x "
                android:layout_marginEnd="@dimen/_3sdp"
                android:layout_gravity="center"/>

            <ImageView
                android:layout_width="@dimen/_8sdp"
                android:layout_height="@dimen/_8sdp"
                android:src="@drawable/ic_speed_video"
                android:layout_gravity="center"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/loading_progress"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone"
            style="@style/Widget.AppCompat.ProgressBar"
            android:indeterminateDrawable="@drawable/loading_video_progress"
            />

        <FrameLayout
            android:id="@+id/l_dialog_exit"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_loading"
            android:visibility="gone"
            android:onClick="onClick"
            tools:ignore="UsingOnClickInXml">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/_12sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dialog"
                android:gravity="center"
                android:layout_marginHorizontal="@dimen/_20sdp"
                android:layout_gravity="center">

                <TextView
                    android:id="@+id/dialog_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text_12_Bold"
                    android:gravity="center"
                    android:text="@string/exit_confirm"
                    android:maxLines="2"
                    android:layout_marginBottom="@dimen/_12sdp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/account_header">

                    <TextView
                        android:id="@+id/btn_ok"
                        android:layout_width="@dimen/_80sdp"
                        android:layout_height="@dimen/_25sdp"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/confirm"
                        style="@style/Text_10_Bold"
                        android:background="@drawable/bg_btn_yellow_radius_6sdp"
                        android:gravity="center"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_marginEnd="@dimen/_5sdp"
                        android:textColor="@color/black"
                        android:onClick="onClick"
                        tools:ignore="UsingOnClickInXml"/>

                    <TextView
                        android:id="@+id/btn_cancel"
                        android:layout_width="@dimen/_80sdp"
                        android:layout_height="@dimen/_25sdp"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/cancel"
                        android:textColor="@color/black"
                        style="@style/Text_10_Bold"
                        android:background="@drawable/bg_btn_white_radius_6sdp"
                        android:gravity="center"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:onClick="onClick"
                        tools:ignore="UsingOnClickInXml"/>

                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/l_dialog_error_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_loading"
            android:visibility="gone"
            tools:ignore="UsingOnClickInXml">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/_12sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dialog"
                android:gravity="center"
                android:layout_marginHorizontal="@dimen/_20sdp"
                android:layout_gravity="center">

                <TextView
                    android:id="@+id/dialog_error_video_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text_12_Bold"
                    android:gravity="center"
                    android:text="@string/exit_confirm"
                    android:maxLines="2"
                    android:layout_marginBottom="@dimen/_12sdp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/account_header">

                    <TextView
                        android:id="@+id/btn_retry_error_video"
                        android:layout_width="@dimen/_80sdp"
                        android:layout_height="@dimen/_25sdp"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/retry"
                        style="@style/Text_10_Bold"
                        android:background="@drawable/bg_btn_yellow_radius_6sdp"
                        android:gravity="center"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_marginEnd="@dimen/_5sdp"
                        android:textColor="@color/black"
                        android:onClick="onClick"
                        tools:ignore="UsingOnClickInXml"
                        />

                    <TextView
                        android:id="@+id/btn_exit_error_video_"
                        android:layout_width="@dimen/_80sdp"
                        android:layout_height="@dimen/_25sdp"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/exit"
                        android:textColor="@color/black"
                        style="@style/Text_10_Bold"
                        android:background="@drawable/bg_btn_white_radius_6sdp"
                        android:gravity="center"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:onClick="onClick"
                        tools:ignore="UsingOnClickInXml"/>

                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

    </FrameLayout>
</layout>

