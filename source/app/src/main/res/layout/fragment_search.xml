<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="f"
            type="com.movie_hub.android.ui.main.search.SearchFragment"/>
        <variable
            name="vm"
            type="com.movie_hub.android.ui.main.search.SearchViewModel"/>

        <import type="android.view.View"/>
    </data>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/account_header"
        android:fitsSystemWindows="true"
        >

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/account_header">

            <EditText
                android:id="@+id/search"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_26sdp"
                android:background="@drawable/bg_search_bar"
                android:layout_marginTop="@dimen/_16sdp"
                android:layout_marginBottom="@dimen/_12sdp"
                android:gravity="center|start"
                style="@style/Text_12_Normal"
                android:singleLine="true"
                android:drawableStart="@drawable/ic_search_bar"
                android:drawableEnd="@drawable/ic_clear"
                android:layout_marginHorizontal="@dimen/_12sdp"
                android:drawablePadding="@dimen/_12sdp"
                android:imeOptions="actionSearch"
                android:inputType="text"/>

        </FrameLayout>

        <FrameLayout
            android:id="@+id/contentView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_app"/>

    </LinearLayout>
</layout>