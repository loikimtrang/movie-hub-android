<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_episode_list"
    android:padding="@dimen/_12sdp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_img"
            android:layout_width="@dimen/_80sdp"
            android:layout_height="wrap_content">


            <FrameLayout
                android:id="@+id/layout_image"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintDimensionRatio="2:3">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/movieVerticalImg"/>

            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_gravity="center_vertical"
            android:layout_toEndOf="@+id/layout_img"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Text_14_Normal"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="@string/name"/>

            <TextView
                android:id="@+id/tv_sub_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Text_12_Normal"
                android:textColor="@color/text_cate"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/name"
                android:layout_marginTop="@dimen/_3sdp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/_6sdp"
                android:gravity="center">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/img_avatar"
                    android:layout_width="@dimen/_16sdp"
                    android:layout_height="@dimen/_16sdp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/roundImg"
                    android:src="@drawable/logo"
                    android:layout_gravity="center"
                    android:layout_marginEnd="@dimen/_6sdp"/>

                <TextView
                    android:id="@+id/tv_name_author"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text_12_Normal"
                    android:textColor="@color/text_cate"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/name"/>

                <ImageView
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:src="@drawable/ic_dot"
                    android:layout_gravity="center"/>

                <TextView
                    android:id="@+id/tv_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text_12_Normal"
                    android:textColor="@color/text_cate"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/name"/>

            </LinearLayout>

            <TextView
                android:id="@+id/day_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Text_12_Normal"
                android:textColor="@color/text_cate"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/name"
                android:layout_marginTop="@dimen/_3sdp"
                android:visibility="gone"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_ic_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="@dimen/_3sdp"
            android:background="@drawable/bg_ic_live"
            android:layout_alignParentEnd="true"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ic_dot_live"
                android:layout_width="@dimen/_6sdp"
                android:layout_height="@dimen/_6sdp"
                android:src="@drawable/ic_dot_live" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Text_10_Bold"
                android:text="@string/status_live"
                android:layout_marginStart="@dimen/_3sdp"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_ic_waiting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_3sdp"
            android:background="@drawable/bg_ic_waiting_live"
            android:layout_alignParentEnd="true"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ic_hourglass"
                android:layout_width="@dimen/_10sdp"
                android:layout_height="@dimen/_19sdp"
                android:src="@drawable/ic_hourglass" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Text_10_Bold"
                android:text="@string/status_waiting"
                android:layout_marginStart="@dimen/_3sdp"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_ic_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_3sdp"
            android:background="@drawable/bg_ic_end_live"
            android:layout_alignParentEnd="true"
            android:visibility="visible">

            <ImageView
                android:id="@+id/ic_end"
                android:layout_width="@dimen/_10sdp"
                android:layout_height="@dimen/_19sdp"
                android:src="@drawable/ic_end_live" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Text_10_Bold"
                android:textColor="@color/orange"
                android:text="@string/status_ended"
                android:layout_marginStart="@dimen/_3sdp"/>

        </LinearLayout>

    </RelativeLayout>

</FrameLayout>
