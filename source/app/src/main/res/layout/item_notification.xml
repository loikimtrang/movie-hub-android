<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="item"
            type="com.movie_hub.android.data.model.api.response.notification.NotificationResponse" />
    </data>

    <RelativeLayout
        android:id="@+id/layout_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_btn_press_tran">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_avatar"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/roundImg"
            android:src="@drawable/logo"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_centerVertical="true"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginVertical="@dimen/_12sdp"
            android:layout_marginEnd="@dimen/_6sdp"
            android:layout_toEndOf="@+id/img_avatar"
            android:layout_toStartOf="@+id/img_movie">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:text="@{item.title}"
                android:maxLines="3"
                style="@style/Text_14_Normal"/>

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="@dimen/_3sdp"
                android:textColor="@color/text_gray"
                style="@style/Text_10_Normal"/>

        </LinearLayout>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_movie"
            android:layout_width="@dimen/_64sdp"
            android:layout_height="@dimen/_36sdp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/imgNotification"
            android:src="@drawable/logo"
            android:layout_gravity="center"
            android:layout_centerVertical="true"
            android:visibility="gone"
            android:layout_marginEnd="@dimen/_6sdp"
            android:layout_toStartOf="@+id/ic_un_read"
            />

        <ImageView
            android:layout_width="@dimen/_8sdp"
            android:layout_height="@dimen/_8sdp"
            android:id="@+id/ic_un_read"
            android:src="@drawable/ic_un_read"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="@dimen/_6sdp"/>

    </RelativeLayout>
</layout>
